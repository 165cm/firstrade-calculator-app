# Gumroad License Configuration
# IMPORTANT: GUMROAD_PRODUCT_ID must be the actual Product ID from Gumroad dashboard
# (found in: Product Edit > Content > License Keys), NOT the permalink!
# Example: If your product URL is https://papazon.gumroad.com/l/firstrade-ja
# The permalink "firstrade-ja" will NOT work - you need the actual Product ID
GUMROAD_PRODUCT_ID=your_gumroad_product_id
NEXT_PUBLIC_GUMROAD_PRODUCT_URL=https://yourname.gumroad.com/l/your-product

# Announcement Mode (true = show announcement but allow free access)
NEXT_PUBLIC_ANNOUNCEMENT_MODE=true

# License Expiry Date (YYYY-MM-DD format, e.g., 2026-12-31 for 2025 version)
# 日本時間のその日の終わりまで有効
GUMROAD_LICENSE_EXPIRY=2026-12-31

# 年度版ごとのGumroad商品（設定すると GUMROAD_PRODUCT_ID / GUMROAD_LICENSE_EXPIRY より優先）
# 形式: 版名:商品ID:有効期限 をカンマ区切り。どの版のキーでも認証でき、版ごとに期限を判定する
# 例: GUMROAD_PRODUCTS=2026年版:新商品ID:2027-12-31,2025年版:旧商品ID:2026-12-31
GUMROAD_PRODUCTS=

# License Token Secret (必須・本番): ライセンス認証トークンの署名鍵（32文字以上のランダム文字列）
# 生成例: openssl rand -hex 32
# ※ 変更すると発行済みトークンは無効になります（保存済みキーで自動再認証されます）
LICENSE_TOKEN_SECRET=

# Invite / Coupon Codes: 招待コード（カンマ区切り）。コードはリポジトリに書かず、ここで管理する
# 「コード:有効期限」で期限を付けられる（例: NOTE2026:2027-12-31,FRIEND）。大文字小文字は区別しない
LICENSE_COUPON_CODES=

# Cron Secret: 為替更新API（POST /api/exchange-rates, /api/exchange-rates/update）の認証用
# 未設定の場合、これらのエンドポイントは無効（404）になります
# 呼び出し時は "Authorization: Bearer <CRON_SECRET>" ヘッダーを付与
CRON_SECRET=

# Gemini (Chat Support)
GEMINI_API_KEY=
# 使用モデル（省略時: gemini-2.5-flash）
GEMINI_MODEL=
# チャットの1日あたり上限（インスタンス単位、省略時: 500）
CHAT_DAILY_LIMIT=

# 信頼するプロキシの段数（X-Forwarded-For の末尾から数える）
# Cloud Run 直結: 1（既定） / 外部HTTPSロードバランサー経由: 2
TRUSTED_PROXY_COUNT=1
